# ── OpenAI (필수) ─────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-...

# ── Tavily Search (필수: 트렌드 검색) ────────────────────
# https://tavily.com → 무료 1,000회/월
TAVILY_API_KEY=tvly-...

# ── Pexels (선택: 실사 배경 사진) ────────────────────────
# https://www.pexels.com/api → 무료, 즉시 발급
PEXELS_API_KEY=

# ── Instagram Graph API (선택: 자동 업로드) ───────────────
# Instagram API with Instagram Login만 사용합니다.
# 설정 가이드: docs/runbooks/instagram-auth-setup.md
# 앱 자격증명과 redirect URI는 OAuth 셋업에만 사용하며 Git에 커밋하지 않습니다.
META_APP_ID=
META_APP_SECRET=
IG_REDIRECT_URI=
IG_ACCESS_TOKEN=
IG_USER_ID=
# 게시 시 필수. 빈 값은 fail-closed로 차단됩니다.
# 공개 HTTPS URL을 사용하거나, 제3자 공개 업로드를 명시적으로 승인한 경우 catbox 입력
# 예: https://abc123.example.com 또는 catbox
IG_IMAGE_BASE_URL=

# ── Threads (선택: Threads 동시 발행) ────────────────────
# Threads API 전용 토큰을 별도로 설정합니다.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── 블로그 (선택: 블로그 자동 포스팅) ────────────────────
# 티스토리: https://www.tistory.com/guide/api/manage/register
TISTORY_ACCESS_TOKEN=
TISTORY_BLOG_NAME=

# 네이버 블로그: https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ACCESS_TOKEN=

# ── 텔레그램 봇 (선택: 폰으로 승인/알림) ────────────────
# 1. @BotFather 에서 /newbot → 토큰 발급
# 2. 봇에 메시지 전송 후 https://api.telegram.org/bot<TOKEN>/getUpdates 로 Chat ID 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 파이프라인 기본 설정 ──────────────────────────────────
ALGO_ENV=production
AGENT_AUTO_UPLOAD=false
AGENT_DRY_RUN=true
DEFAULT_TOPIC=AI 트렌드
NUM_CARDS=6
OUTPUT_DIR=output
